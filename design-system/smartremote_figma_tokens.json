  },
  "spacing": {
    "grid": { "value": "4dp", "type": "spacing" },
    "space4": { "value": "4dp", "type": "spacing" },
    "space8": { "value": "8dp", "type": "spacing" },
    "space12": { "value": "12dp", "type": "spacing" },
    "space16": { "value": "16dp", "type": "spacing" },
    "space20": { "value": "20dp", "type": "spacing" },
    "space24": { "value": "24dp", "type": "spacing" },
    "space32": { "value": "32dp", "type": "spacing" },
    "space48": { "value": "48dp", "type": "spacing" }
  },
  "elevation": {
    "level0": { "value": "none", "type": "boxShadow" },
    "level1": { "value": "0px 2px 8px rgba(0, 0, 0, 0.3)", "type": "boxShadow", "description": "Cards" },
    "level2": { "value": "0px 6px 16px rgba(0, 0, 0, 0.4)", "type": "boxShadow", "description": "D-Pad and FAB" },
    "level3": { "value": "0px 12px 32px rgba(0, 0, 0, 0.6)", "type": "boxShadow", "description": "Modals and Overlays" }
  },
  "animation": {
    "screenTransition": {
      "duration": "300ms",
      "easing": "cubic-bezier(0.16, 1, 0.3, 1)",
      "type": "transition",
      "description": "Slide + Fade"
    },
    "buttonPress": {
      "duration": "100ms",
      "scale": "0.95",
      "easing": "cubic-bezier(0.4, 0, 0.2, 1)",
      "type": "transform"
    },
    "voicePulse": {
      "duration": "1800ms",
      "type": "loop",
      "description": "Pulsing radial soundwave"
    },
    "cardShimmer": {
      "duration": "1400ms",
      "type": "loop",
      "description": "Linear gradient loading sweep"
    },
    "successCheck": {
      "duration": "350ms",
      "easing": "cubic-bezier(0.175, 0.885, 0.32, 1.275)",
      "type": "scaleUp"
    },
    "errorShake": {
      "duration": "320ms",
      "count": 3,
      "distance": "9px",
      "type": "shake"
    }
  },
  "accessibility": {
    "minTouchTarget": "48dp",
    "contrastRatio": "15.3:1 (AAA)",
    "bilingualLanguages": ["English", "Hindi"],
    "voiceEngine": "Offline Native SpeechRecognizer (Hindi transliterated + English)"
  }
}
